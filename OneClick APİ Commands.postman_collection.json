				"exec": [
					"",
					"const CryptoJS = require('crypto-js');",
					"",
					"function generateRandomNonce(length = 8) {",
					"    const characters = 'abcdefghijklmnopqrstuvwxyz0123456789'; ",
					"    let nonce = '';",
					"    for (let i = 0; i < length; i++) {",
					"        const randomIndex = Math.floor(Math.random() * characters.length);",
					"        nonce += characters[randomIndex];",
					"    }",
					"    return nonce;",
					"}",
					"",
					"function getCurrentDatetimeUTCPlus4() {",
					"    const now = new Date();",
					"    now.setUTCHours(now.getUTCHours() + 4); ",
					"    const year = now.getUTCFullYear();",
					"    const month = String(now.getUTCMonth() + 1).padStart(2, '0');",
					"    const day = String(now.getUTCDate()).padStart(2, '0');",
					"    const hours = String(now.getUTCHours()).padStart(2, '0');",
					"    const minutes = String(now.getUTCMinutes()).padStart(2, '0');",
					"    const seconds = String(now.getUTCSeconds()).padStart(2, '0');",
					"    return `${year}${month}${day}${hours}${minutes}${seconds}`;",
					"}",
					"",
					"function sha256(input) {",
					"    return CryptoJS.SHA256(input).toString(CryptoJS.enc.Hex);",
					"}",
					"",
					"(function generateHash() {",
					"    const dt = getCurrentDatetimeUTCPlus4();",
					"    const nonce = generateRandomNonce();",
					"    const key = \"test\";",
					"",
					"    const dtHash = sha256(dt);",
					"    const combinedString = `${dtHash}:${nonce}:${key}`;",
					"    const finalHash = sha256(combinedString);",
					"",
					"    pm.request.headers.add({key:'token',value:finalHash});",
					"",
					"    pm.request.headers.add({key:'dt', value:dt});",
					"",
					"    pm.request.headers.add({key:'nonce',value:nonce});",
					"",
					"    console.log(\"Datetime (UTC+4):\", dt);",
					"    console.log(\"First Hash (dt):\", dtHash);",
					"    console.log(\"Combined String:\", combinedString);",
					"    console.log(\"Final Hash:\", finalHash);",
					"})();",
					""
				]
			}
