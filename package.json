{
  "name": "pos-redesing",
  "version": "1.0.0",
  "description": "",
  "main": "electron/server/main.js",
  "scripts": {
    "start": "concurrently \"npm run dev-react\" \"npm run start-electron\"",
    "dev-react": "npm run dev --prefix electron/front",
    "start-electron": "wait-on http://localhost:5173 && electron .",
    "build-front": "npm run build --prefix electron/front",
    "dist": "npm run build-front && electron .",
    "pack": "npm run build-front && electron-builder --win --dir"
  },
  "build": {
    "appId": "com.pos.redesing",
    "productName": "POS Redesing",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "electron/server/**/*",
      "electron/backend/**/*",
      "electron/front/dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": "dir"
    }
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^40.0.0",
    "electron-builder": "^24.13.3",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "axios": "^1.13.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mariadb": "^3.4.5",
    "sequelize": "^6.37.7"
  }
}