{
  "name": "unipos-desktop-app",
  "version": "2.1.83",
  "description": "UniPOS Desktop Application",
  "author": "UniPOS MMC (UniPOS LLC)",
  "main": "electron/server/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/jumshudsoltanov/NewUniPOS.git"
  },
  "scripts": {
    "start": "concurrently --kill-others \"npm run dev-react\" \"npm run start-electron\"",
    "dev-react": "npm run dev --prefix electron/front",
    "start-electron": "wait-on http://localhost:5173 && electron .",
    "build-front": "npm run build --prefix electron/front",
    "prepare-icon": "node scripts/prepare-build-icon.js",
    "dist": "npm run prepare-icon && npm run build-front && electron-builder --win --x64 --ia32 --publish=never",
    "dist-ia32": "npm run prepare-icon && npm run build-front && electron-builder --win --ia32 --publish=never",
    "pack": "npm run prepare-icon && npm run build-front && electron-builder --win --dir --publish=never",
    "release": "npm run prepare-icon && npm run build-front && electron-builder --win --x64 --ia32 --publish=always",
    "release-ia32": "npm run prepare-icon && npm run build-front && electron-builder --win --ia32 --publish=always"
  },
  "build": {
    "appId": "com.unipos.tech",
    "productName": "UniPOS Desktop Application",
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "jumshudsoltanov",
        "repo": "NewUniPOS"
      }
    ],
    "files": [
      "electron/server/**/*",
      "electron/backend/**/*",
      "electron/front/dist/**/*",
      "electron/static/**/*",
      "package.json",
      "node_modules/**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!electron/front/src/**/*",
      "!electron/front/node_modules/**/*",
      "!electron/mobile/**/*"
    ],
    "extraResources": [
      ".env"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.{node,dll}",
      "node_modules/electron-updater/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "electron/static/images/logo-build.ico",
      "requestedExecutionLevel": "asInvoker",
      "verifyUpdateCodeSignature": false,
      "publisherName": "UniPOS LLC",
      "signDlls": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "warningsAsErrors": false
    }
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^22.3.27",
    "electron-builder": "^24.13.3",
    "sharp": "^0.32.6",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "electron-log": "^4.4.8",
    "electron-updater": "^5.3.0",
    "express": "^4.21.2",
    "mariadb": "3.3.2",
    "png-to-ico": "^3.0.1",
    "sequelize": "^6.37.7",
    "socket.io": "^4.8.3"
  }
}
